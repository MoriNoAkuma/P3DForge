<UserControl x:Class="P3DForge.App.Viewport.ViewportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid x:Name="Root" Background="#2A2D33" ClipToBounds="True">
        <gl:GLWpfControl x:Name="Gl" />
        <!-- per-pane chrome: border, view name and 2D labels (proxies, memory points); built in code -->
        <Canvas x:Name="PaneLayer" IsHitTestVisible="False" />
        <Canvas x:Name="Overlay" IsHitTestVisible="False" />
        <!-- stats overlay (view.stats) and the sun direction readout while Alt+Shift+LMB dragging -->
        <Border x:Name="StatsPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,6,8,6"
                CornerRadius="3" Background="#C0181A1F" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="11" Foreground="#D8DCE4" />
                <Canvas x:Name="StatsGraph" Width="170" Height="34" Margin="0,5,0,0" ClipToBounds="True" Background="#30000000">
                    <Line x:Name="StatsBudget" X1="0" X2="170" Stroke="#50FFFFFF" StrokeThickness="1" StrokeDashArray="2 3" />
                    <Polyline x:Name="StatsLine" Stroke="#6FC3FF" StrokeThickness="1" />
                    <Polyline x:Name="StatsGpuLine" Stroke="#F0B050" StrokeThickness="1" />
                </Canvas>
            </StackPanel>
        </Border>
        <Border x:Name="SunPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,3,6,3" CornerRadius="3"
                Background="#C0181A1F" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SunText" FontSize="11" Foreground="#FFD27A" />
        </Border>
        <TextBlock x:Name="ErrorText" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#F0605D" TextWrapping="Wrap" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>
