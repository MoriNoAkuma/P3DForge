<Window x:Class="P3DForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:vp="clr-namespace:P3DForge.App.Viewport"
        Title="P3D Forge" Width="1600" Height="1000" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="#1B1D22">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="13" />
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar x:Name="MainToolbar" Band="0" />
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" FontSize="12">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusSelection" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusCounts" Margin="12,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusLod" Margin="12,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True">
            <ad:DockingManager.Theme>
                <adt:Vs2013DarkTheme />
            </ad:DockingManager.Theme>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePaneGroup x:Name="LeftGroup" DockWidth="300" Orientation="Vertical" />
                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument Title="Viewport" ContentId="viewport" CanClose="False" CanFloat="False">
                                <vp:ViewportView x:Name="Viewport" />
                            </ad:LayoutDocument>
                        </ad:LayoutDocumentPane>
                        <ad:LayoutAnchorablePane x:Name="BottomPane" DockHeight="200" />
                    </ad:LayoutPanel>
                    <ad:LayoutAnchorablePaneGroup x:Name="RightGroup" DockWidth="320" Orientation="Vertical" />
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
