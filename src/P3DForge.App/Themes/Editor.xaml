<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared editor resources (on top of WPF's Fluent dark theme). Reuse these keys in panels. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="Editor.Accent" Color="#4F9CFF" />
    <SolidColorBrush x:Key="Editor.Selection" Color="#FF9D3B" />
    <SolidColorBrush x:Key="Editor.Warn" Color="#E3B341" />
    <SolidColorBrush x:Key="Editor.Error" Color="#F0605D" />
    <SolidColorBrush x:Key="Editor.Ok" Color="#4CC38A" />
    <SolidColorBrush x:Key="Editor.Dim" Color="#9AA1AD" />
    <SolidColorBrush x:Key="Editor.Faint" Color="#6B7280" />
    <SolidColorBrush x:Key="Editor.PanelBackground" Color="#1E2025" />

    <!-- Compact controls for dense editor panels (Fluent defaults are large). -->
    <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Narrow number fields: the Fluent template's "clear" (x) button would cover the digits, so a plain template. -->
    <Style x:Key="NumberTextBox" TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PanelHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Editor.Dim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="6,2" />
    </Style>
</ResourceDictionary>
